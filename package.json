{
  "name": "@overthinker1127/port-contracts",
  "version": "10.10.0",
  "description": "Shared protobuf contracts for port services.",
  "private": false,
  "license": "UNLICENSED",
  "files": [
    "dist",
    "proto",
    "buf.yaml",
    "buf.gen.yaml"
  ],
  "scripts": {
    "generate": "buf generate",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "lint:proto": "buf lint",
    "test:wire": "npm run build && node --test tests/*.test.cjs",
    "check": "npm run lint:proto && npm run generate && npm run build && node --test tests/*.test.cjs"
  },
  "exports": {
    "./speech-correction": {
      "types": "./dist/speech-correction/index.d.ts",
      "default": "./dist/speech-correction/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "default": "./dist/templates/index.js"
    },
    "./gen/ts/*": {
      "types": "./dist/gen/ts/*.d.ts",
      "default": "./dist/gen/ts/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "speech-correction": [
        "dist/speech-correction/index"
      ],
      "templates": [
        "dist/templates/index"
      ],
      "gen/ts/*": [
        "dist/gen/ts/*"
      ]
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@grpc/grpc-js": "^1.14.0",
    "liquidjs": "10.30.1",
    "protobufjs": "^7.5.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
